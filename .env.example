# Copy to .env and replace every "change-me" value.
# .env is git-ignored; never commit real secrets.

# PostgreSQL superuser: used only by the database container on first start.
POSTGRES_PASSWORD=change-me

# Owns the schema and runs Flyway migrations (DDL). Used only by the "migrate" service.
FLOWPILOT_DB_MIGRATOR_PASSWORD=change-me

# Used by the running application (data access only, no DDL).
FLOWPILOT_DB_APP_PASSWORD=change-me

# Signs access tokens. Base64 of at least 32 random bytes, e.g. in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or on Linux/macOS:  openssl rand -base64 48
FLOWPILOT_JWT_SECRET=change-me

# Browser origins allowed to call the API (comma-separated, optional).
# FLOWPILOT_ALLOWED_ORIGINS=http://localhost:5173

# Host port for the API (optional, default 8090).
# FLOWPILOT_HTTP_PORT=8090
