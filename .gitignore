# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# --- Backend (Maven) ---
backend/target/
# Generated by Spring Modulith's annotation processor during compilation
build/
!backend/.mvn/wrapper/maven-wrapper.jar

# --- Frontend (Node / Vite) ---
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# --- Python (docs/uml generator) ---
__pycache__/
.venv/

# --- Runtime data ---
data/
logs/
*.log

# --- IDEs and OS ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
